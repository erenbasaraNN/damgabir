# Local development. Use the public HTTPS origin when deploying.
DAMGABIR_PUBLIC_ORIGIN=http://localhost:3000

# Set a generated secret before starting a production instance.
DAMGABIR_OWNER_KEY=

# Direct Node deployment only. Compose mounts /var/lib/damgabir instead.
DAMGABIR_DATA_DIR=./.data

# Optional. Set both for shared storage or an ephemeral/serverless host.
LIBSQL_DATABASE_URL=
LIBSQL_AUTH_TOKEN=

# Optional. Existing TURSO_DATABASE_URL and TURSO_AUTH_TOKEN are also supported.
# Optional. NTAG 424 DNA registration only. NTAG213 is configured in the merchant panel.
# DAMGABIR_NFC_CARDS={}
